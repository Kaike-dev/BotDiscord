# Obrigatorio: token secreto da pagina "Bot" no Discord Developer Portal.
DISCORD_TOKEN=

# Obrigatorio para registrar os slash commands: Application ID da aplicacao.
CLIENT_ID=

# Opcional: ID de um servidor para registrar comandos instantaneamente em desenvolvimento.
# Deixe vazio para registrar os comandos globalmente.
GUILD_ID=

# Caminho do arquivo de dados. No Docker Compose, este valor e sobrescrito.
DATA_FILE=./data/tournaments.json
